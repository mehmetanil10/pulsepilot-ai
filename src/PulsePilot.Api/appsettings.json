{
  "ConnectionStrings": {
    "Database": ""
  },
  "Database": {
    "RunMigrations": false
  },
  "Seed": {
    "Run": false,
    "Email": "demo@pulsepilot.ai",
    "Password": "",
    "DisplayName": "PulsePilot Demo Owner",
    "WorkspaceName": "PulsePilot Demo",
    "FeedbackCount": 100
  },
  "Jwt": {
    "Issuer": "PulsePilot.Api",
    "Audience": "PulsePilot.Clients",
    "Secret": "",
    "ExpirationMinutes": 60
  },
  "OpenAI": {
    "Enabled": false,
    "ApiKey": "",
    "Model": "gpt-5.6-luna",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingDimensions": 1536,
    "Endpoint": "https://api.openai.com/v1/",
    "MaxOutputTokenCount": 1000,
    "NetworkTimeoutSeconds": 30
  },
  "SemanticSearch": {
    "SimilarityThreshold": 0.8,
    "DefaultLimit": 10,
    "MaxLimit": 50
  },
  "FeedbackStatistics": {
    "DefaultPeriodDays": 7,
    "MaxPeriodDays": 365
  },
  "PriorityScoring": {
    "SeverityWeight": 0.35,
    "FrequencyWeight": 0.30,
    "CustomerImpactWeight": 0.20,
    "RecencyWeight": 0.15,
    "FrequencyNormalizationCount": 20,
    "CustomerImpactNormalizationCount": 10,
    "RecencyWindowDays": 7,
    "P1Threshold": 75,
    "P2Threshold": 50,
    "P3Threshold": 25
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
