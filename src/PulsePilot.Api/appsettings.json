{
  "ConnectionStrings": {
    "Database": ""
  },
  "Database": {
    "RunMigrations": false
  },
  "Seed": {
    "Run": false,
    "Email": "demo@pulsepilot.ai",
    "Password": "",
    "DisplayName": "PulsePilot Demo Owner",
    "WorkspaceName": "PulsePilot Demo",
    "FeedbackCount": 100
  },
  "Jwt": {
    "Issuer": "PulsePilot.Api",
    "Audience": "PulsePilot.Clients",
    "Secret": "",
    "ExpirationMinutes": 60
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
