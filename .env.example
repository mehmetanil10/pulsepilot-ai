COMPOSE_PROJECT_NAME=pulsepilot
IMAGE_TAG=local
API_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=pulsepilot
POSTGRES_USER=pulsepilot
POSTGRES_PASSWORD=change-me
JWT_ISSUER=PulsePilot.Api
JWT_AUDIENCE=PulsePilot.Clients
JWT_SECRET=change-me
JWT_EXPIRATION_MINUTES=60
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_ENDPOINT=https://api.openai.com/v1/
OPENAI_MAX_OUTPUT_TOKENS=1000
OPENAI_NETWORK_TIMEOUT_SECONDS=30
FEEDBACK_PROCESSING_ENABLED=false
FEEDBACK_PROCESSING_POLL_INTERVAL_MS=1000
FEEDBACK_PROCESSING_RECOVERY_INTERVAL_SECONDS=60
FEEDBACK_PROCESSING_STALE_THRESHOLD_MINUTES=5
FEEDBACK_PROCESSING_MAX_ATTEMPTS=3
FEEDBACK_PROCESSING_TIMEOUT_SECONDS=45
FEEDBACK_PROCESSING_BASE_RETRY_DELAY_MS=500
FEEDBACK_PROCESSING_MAX_RETRY_DELAY_SECONDS=5
FEEDBACK_PROCESSING_RETRY_JITTER_FACTOR=0.2
FEEDBACK_PROCESSING_MAX_RECOVERED_PER_SWEEP=100
SEED_DEMO_DATA=false
SEED_DEMO_EMAIL=demo@pulsepilot.ai
SEED_DEMO_PASSWORD=change-me
SEED_FEEDBACK_COUNT=100
ASPNETCORE_ENVIRONMENT=Development
